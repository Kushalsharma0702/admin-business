# ── Database ──────────────────────────────────────────────────────────────────
# This service's own DB (taxease_admin).
DATABASE_URL=postgresql://postgres:password@localhost:5432/taxease

# The Flutter/Python app DB (the `postgres` database on the same RDS instance).
# REQUIRED in production: accept-invite mirrors each new client into this DB's
# users table, and the customer-type lookup reads from it. Without it, invited
# clients can set a password but cannot log in to the mobile app.
MAIN_DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:8080
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_EXPIRES_IN=24h

# ── AWS ───────────────────────────────────────────────────────────────────────
AWS_REGION=ca-central-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key

# ── S3 ────────────────────────────────────────────────────────────────────────
S3_BUCKET=taxease-uploads
S3_PRESIGN_EXPIRY=300

# ── SES ───────────────────────────────────────────────────────────────────────
SES_FROM_EMAIL=noreply@taxease.ca
SES_FROM_NAME=TaxEase

# ── (Optional) AWS Secrets Manager — pulls DATABASE_URL and JWT_SECRET at boot
# AWS_SECRET_NAME=taxease/production
